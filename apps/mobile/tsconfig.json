{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "vue": ["./node_modules/vue"],
      "vue-router": ["./node_modules/vue-router"],
      "lucide-vue-next": ["./node_modules/lucide-vue-next"],
      "@shared/*": ["../../src/shared/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
