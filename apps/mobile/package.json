{
  "name": "tiktokcut-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Klipmill 手机端（Vue 3 + Capacitor）",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "dev:web": "vite --mode web --host 127.0.0.1 --port 18291",
    "build:web": "vue-tsc --noEmit && vite build --mode web",
    "typecheck": "vue-tsc --noEmit",
    "sync:android": "npm run build && cap sync android",
    "apk": "npm run sync:android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@types/qrcode": "^1.5.6",
    "lucide-vue-next": "^0.515.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.8"
  }
}
