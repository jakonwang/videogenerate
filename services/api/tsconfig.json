{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": "../../",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["./**/*.ts", "../../src/main/**/*.ts", "../../src/shared/**/*.ts", "../../src/types/**/*.d.ts"]
}
