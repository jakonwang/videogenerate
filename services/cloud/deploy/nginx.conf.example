# Klipmill · Nginx 示例（把 example.com 换成你的域名，证书用 certbot 或云厂商证书）
#   www.example.com    官网 + 用户中心 + 管理后台（/admin）  -> Next.js :18280
#   api.example.com    云端 API（客户端、网页、支付回调都走这里） -> :18300
#   update.example.com 客户端安装包与自动更新文件（静态目录）

server {
  listen 443 ssl http2;
  server_name api.example.com;
  ssl_certificate     /etc/ssl/example.com/fullchain.pem;
  ssl_certificate_key /etc/ssl/example.com/privkey.pem;

  client_max_body_size 2m;
  location / {
    proxy_pass http://127.0.0.1:18300;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;
  }
  # 同步文件上传（素材、视频，单个最多 200 MB）
  location /api/v1/files {
    client_max_body_size 210m;
    proxy_pass http://127.0.0.1:18300;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 300s;
    proxy_request_buffering off;
  }
  # 电脑代办：网页调用电脑端功能最长等 2 分钟，电脑长轮询 25 秒，结果最大 16 MB
  location /api/v1/relay/ {
    client_max_body_size 16m;
    proxy_pass http://127.0.0.1:18300;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 150s;
    proxy_buffering off;
  }
  # 电脑端 AI 代理：平台 Key 只在服务器，生成请求经这里转发并扣点。
  # 请求体含 base64 参考图（最多 64 MB）；同步出图可能要几分钟；对话是流式输出
  location /api/v1/ai-proxy/ {
    client_max_body_size 64m;
    proxy_pass http://127.0.0.1:18300;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    proxy_buffering off;
  }
}

server {
  listen 443 ssl http2;
  server_name www.example.com example.com;
  ssl_certificate     /etc/ssl/example.com/fullchain.pem;
  ssl_certificate_key /etc/ssl/example.com/privkey.pem;

  location / {
    proxy_pass http://127.0.0.1:18280;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
  }
}

server {
  listen 443 ssl http2;
  server_name update.example.com;
  ssl_certificate     /etc/ssl/example.com/fullchain.pem;
  ssl_certificate_key /etc/ssl/example.com/privkey.pem;

  root /srv/tiktokcut/releases;
  # latest.yml 不能被缓存，否则客户端发现不了新版本
  location ~ \.yml$ { add_header Cache-Control "no-cache"; }
  location / { autoindex off; }
}

server {
  listen 80;
  server_name api.example.com www.example.com example.com update.example.com;
  return 301 https://$host$request_uri;
}
