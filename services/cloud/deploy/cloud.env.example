# Klipmill 云端服务 · 生产环境变量模板
# 复制为 /srv/tiktokcut/cloud.env，填好后由 PM2 读取。不要把真实值提交进仓库。

NODE_ENV=production
CLOUD_HOST=127.0.0.1
CLOUD_PORT=18300
CLOUD_DATA_DIR=/srv/tiktokcut/data
CLOUD_PUBLIC_BASE_URL=https://api.example.com
CLOUD_CORS_ORIGINS=https://www.example.com
CLOUD_TRUST_PROXY=1
CLOUD_ALLOW_REGISTRATION=1

# 离线授权时长（天）
CLOUD_ENTITLEMENT_TTL_DAYS=7
CLOUD_UNLIMITED_TTL_DAYS=30

# 微信支付（Native 扫码）。密钥文件放在 $CLOUD_DATA_DIR/keys/ 下，权限 600
WECHATPAY_MCHID=
WECHATPAY_APPID=
WECHATPAY_SERIAL_NO=
WECHATPAY_APIV3_KEY=
WECHATPAY_PLATFORM_SERIAL=
# WECHATPAY_PRIVATE_KEY_PATH=/srv/tiktokcut/data/keys/wechatpay_apiclient_key.pem
# WECHATPAY_PLATFORM_PUBLIC_KEY_PATH=/srv/tiktokcut/data/keys/wechatpay_platform_public.pem

# 支付宝（当面付，公钥模式）
ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY_PATH=/srv/tiktokcut/data/keys/alipay_app_private.pem
# ALIPAY_PUBLIC_KEY_PATH=/srv/tiktokcut/data/keys/alipay_public.pem
# 沙箱联调时改成：https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
