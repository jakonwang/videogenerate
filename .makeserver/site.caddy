# videogenerate 站点：一个域名按路径分流（写到服务器 /srv/edge/sites/<实例>.caddy；${MS_PROJECT} 是实例名）
#   /api/v1/*  云 API（桌面端、网页版、支付回调）
#   /app/*     网页版（云服务提供）
#   /updates/* 桌面端自动更新文件（服务器 /srv/apps/<实例>/shared/update/）
#   其他       官网 + 用户中心 + 后台（Next.js）
# 不带 www 的 klipmill.com 由服务器上单独的 /srv/edge/sites/klipmill-apex.caddy 跳转到这里，
# 这里不要再写 klipmill.com，否则同一个域名出现两次，Caddy 会拒绝加载。
${DOMAIN} {
	encode zstd gzip

	# 电脑端 AI 代理：平台 Key 只在服务器，生成请求经这里转发并扣点。
	# 请求体含 base64 参考图（最多 64MB）；同步出图可能要好几分钟；对话是流式输出
	@aiproxy path /api/v1/ai-proxy/*
	handle @aiproxy {
		request_body {
			max_size 64MB
		}
		reverse_proxy ${MS_PROJECT}-cloud:18300 {
			flush_interval -1
			lb_try_duration 10s
			transport http {
				read_timeout 900s
				write_timeout 900s
			}
		}
	}

	@cloud path /api/v1/* /app /app/*
	handle @cloud {
		# 上传最大 210MB；电脑代办长轮询需要不缓冲
		request_body {
			max_size 210MB
		}
		reverse_proxy ${MS_PROJECT}-cloud:18300 {
			flush_interval -1
			lb_try_duration 10s
			transport http {
				read_timeout 310s
			}
		}
	}

	handle_path /updates/* {
		root * /srv/apps/${MS_PROJECT}/shared/update
		file_server
	}

	handle {
		reverse_proxy ${MS_PROJECT}-web:18280 {
			lb_try_duration 10s
		}
	}
}
