# videogenerate 生产环境变量模板 → ms env init videogenerate 生成 makeserver/secrets/videogenerate.env（只在本机）
# 值里不要出现 $ 符号。下面所有 https://example.com 都换成你的域名。

# ---- 域名：一个域名搞定官网、API、网页版、更新下载 ----
DOMAIN=example.com

# ---- Next.js（构建时写进前端，改了要重新构建）----
NEXT_PUBLIC_CLOUD_API_BASE_URL=https://example.com
VG_APP_ENV=production
VG_ALLOW_MOCK_GENERATION=false
# 桌面端打包时用：VG_CLOUD_API_BASE=https://example.com，VG_UPDATE_BASE_URL=https://example.com/updates
VG_UPDATE_BASE_URL=https://example.com/updates

# ---- 云服务 ----
# CLOUD_HOST / CLOUD_PORT / CLOUD_DATA_DIR / CLOUD_TRUST_PROXY 已在 compose.yml 里固定
CLOUD_PUBLIC_BASE_URL=https://example.com
CLOUD_CORS_ORIGINS=https://example.com
CLOUD_ALLOW_REGISTRATION=1
CLOUD_ENTITLEMENT_TTL_DAYS=7
CLOUD_UNLIMITED_TTL_DAYS=30
# 服务器 ffmpeg 同时跑几个任务，按 CPU 核数调
CLOUD_FFMPEG_CONCURRENCY=1

# 微信支付（Native 扫码）。密钥文件放到服务器 shared/data/keys/，容器里路径是 /data/keys/
WECHATPAY_MCHID=
WECHATPAY_APPID=
WECHATPAY_SERIAL_NO=
WECHATPAY_APIV3_KEY=
WECHATPAY_PLATFORM_SERIAL=
# WECHATPAY_PRIVATE_KEY_PATH=/data/keys/wechatpay_apiclient_key.pem
# WECHATPAY_PLATFORM_PUBLIC_KEY_PATH=/data/keys/wechatpay_platform_public.pem

# 支付宝（当面付，公钥模式）
ALIPAY_APP_ID=
# ALIPAY_APP_PRIVATE_KEY_PATH=/data/keys/alipay_app_private.pem
# ALIPAY_PUBLIC_KEY_PATH=/data/keys/alipay_public.pem
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
