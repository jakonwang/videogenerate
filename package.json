    "test:clone-shot-video-latest-replacement-task-only": "tsx test/clone-shot-video-latest-replacement-task-only.smoke.ts",
    "test:clone-shot-video-jewelry-prompt-v2-lock": "tsx test/clone-shot-video-jewelry-prompt-v2-lock.smoke.ts",
    "test:clone-shot-video-reference-images-payload": "tsx test/clone-shot-video-reference-images-payload.smoke.ts",
    "test:clone-shot-video-audio-filter-safe-prompt": "tsx test/clone-shot-video-audio-filter-safe-prompt.smoke.ts",
    "test:clone-shot-video-start-end-submit-includes-last-image": "tsx test/clone-shot-video-start-end-submit-includes-last-image.smoke.ts",
    "test:clone-shot-video-pick-task-id-string-data": "tsx test/clone-shot-video-pick-task-id-string-data.smoke.ts",
    "test:clone-shot-video-single-pass-running-does-not-timeout": "tsx test/clone-shot-video-single-pass-running-does-not-timeout.smoke.ts",
    "test:clone-storyboard-image-force-regenerate-clears-stale-frame": "tsx test/clone-storyboard-image-force-regenerate-clears-stale-frame.smoke.ts",
    "test:clone-shot-video-succeeded-url-downloads-from-retryable": "tsx test/clone-shot-video-succeeded-url-downloads-from-retryable.smoke.ts",
    "test:tiktok-listing-plugin": "tsx test/tiktok-listing-plugin.smoke.ts",
    "test:tiktok-listing-grs-image-aspect-ratio": "tsx test/tiktok-listing-grs-image-aspect-ratio.smoke.ts",
    "test:tiktok-listing-prompts": "tsx test/tiktok-listing-prompts.smoke.ts"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@remotion/bundler": "^4.0.462",
    "@remotion/renderer": "^4.0.462",
    "@tanstack/react-query": "^5.100.9",
    "@vueuse/core": "^12.5.0",
    "better-sqlite3": "^11.10.0",
    "bufferutil": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fontkit": "^2.0.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.515.0",
    "lucide-vue-next": "^0.515.0",
    "next": "^16.0.1",
    "node-edge-tts": "^1.2.10",
    "node-machine-id": "^1.1.12",
    "p-queue": "^8.1.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.462",
    "replicate": "^1.4.0",
    "tailwind-merge": "^3.3.1",
    "utf-8-validate": "^6.0.6",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@eslint/js": "^9.20.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "chromium-bidi": "^7.3.1",
    "electron": "^34.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.videogenerate.app",
    "productName": "VideoGenerate",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon-brand-ui-v2.png",
        "to": "icon-brand.png"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "icon": "resources/icon-brand-ui-v2.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://update.example.com"
    }
  }
}
