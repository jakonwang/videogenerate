  "build": {
    "appId": "com.videogenerate.app",
    "productName": "Klipmill",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/next/**/*",
      "!node_modules/@next/**/*",
      "!node_modules/@rspack/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/test/**/*",
      "!node_modules/ffprobe-static/bin/linux/**/*",
      "!node_modules/ffprobe-static/bin/win32/ia32/**/*"
    ],
    "afterPack": "scripts/after-pack-prune.cjs",
    "extraResources": [
      {
        "from": "resources/icon-brand-green.png",
        "to": "icon-brand.png"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/*.node",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/win32/x64/**",
      "node_modules/ffprobe-static/bin/darwin/**"
    ],
    "win": {
      "icon": "resources/icon-brand-green.png",
      "extraResources": [
        {
          "from": "tmp/creatok-cli/win/package/bin/creatok.exe",
          "to": "creatok/creatok.exe"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "include": "resources/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "icon": "resources/icon-brand-green.png",
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "tmp/creatok-cli/mac/package/bin",
          "to": "creatok",
          "filter": [
            "creatok"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://update.example.com"
    }
  }
}
