    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.videogenerate.app",
    "productName": "VideoGenerate",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/next/**/*",
      "!node_modules/@next/**/*",
      "!node_modules/@rspack/**/*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/test/**/*",
      "!node_modules/ffprobe-static/bin/darwin/**/*",
      "!node_modules/ffprobe-static/bin/linux/**/*",
      "!node_modules/ffprobe-static/bin/win32/ia32/**/*"
    ],
    "afterPack": "scripts/after-pack-prune.cjs",
    "extraResources": [
      {
        "from": "resources/icon-brand-ui-v2.png",
        "to": "icon-brand.png"
      },
      {
        "from": "resources/live-photo-quality",
        "to": "live-photo-quality"
      },
      {
        "from": "resources/hermes",
        "to": "hermes"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/*.node",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/win32/x64/**"
    ],
    "win": {
      "icon": "resources/icon-brand-ui-v2.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "include": "resources/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://update.example.com"
    }
  }
}
