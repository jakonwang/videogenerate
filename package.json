{
  "name": "videogenerate",
  "productName": "VideoGenerate",
  "description": "批量短视频生成（Electron + Vue3）",
  "author": "VideoGenerate",
  "private": true,
  "version": "0.1.20",
  "main": "out/main/index.js",
  "scripts": {
    "setup:fonts": "node scripts/ensure-bundled-fonts.mjs",
    "copy-fonts": "node scripts/copy-font-resources.mjs",
    "predev": "node scripts/ensure-bundled-fonts.mjs",
    "hermes:doctor": "node scripts/hermes-agent-runner.mjs doctor --config automation/hermes-agent/config.example.json",
    "hermes:run": "node scripts/hermes-agent-runner.mjs run --config automation/hermes-agent/config.example.json --task automation/hermes-agent/task.example.json",
    "dev": "electron-vite dev",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:web-next": "cd apps/web-next && next dev --hostname 127.0.0.1 --port 18280",
    "dev:api": "tsx services/api/server.ts",
    "build": "electron-vite build && node scripts/copy-font-resources.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:web-next": "cd apps/web-next && next build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:web-next": "tsc --noEmit -p apps/web-next/tsconfig.json",
    "typecheck:api": "tsc --noEmit -p services/api/tsconfig.json",
    "start:web-next": "cd apps/web-next && next start --hostname 0.0.0.0 --port 18280",
    "preflight:staging": "node scripts/deploy-preflight.mjs staging",
    "preflight:production": "node scripts/deploy-preflight.mjs production",
    "smoke:api": "node scripts/api-smoke.mjs",
    "smoke:auth-send-code": "node scripts/auth-send-code-smoke.mjs",
    "smoke:web-stack": "node scripts/web-stack-smoke.mjs",
    "guard:encoding": "node scripts/encoding-guard.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "test:web-next-clone-flow": "node test/web-next-clone-flow.e2e.cjs"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@remotion/bundler": "^4.0.462",
    "@remotion/renderer": "^4.0.462",
    "@tanstack/react-query": "^5.100.9",
    "@vueuse/core": "^12.5.0",
    "bufferutil": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fontkit": "^2.0.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.515.0",
    "lucide-vue-next": "^0.515.0",
    "next": "^16.0.1",
    "node-edge-tts": "^1.2.10",
    "node-machine-id": "^1.1.12",
    "p-queue": "^8.1.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.462",
    "tailwind-merge": "^3.3.1",
    "utf-8-validate": "^6.0.6",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@eslint/js": "^9.20.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^34.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.videogenerate.app",
    "productName": "VideoGenerate",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://update.example.com"
    }
  }
}
