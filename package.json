{
  "name": "videogenerate",
  "productName": "VideoGenerate",
  "description": "批量短视频生成工作台（Electron + Vue3）",
  "author": "VideoGenerate",
  "private": true,
  "version": "5.0.16",
  "main": "out/main/index.js",
  "scripts": {
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "setup:fonts": "node scripts/ensure-bundled-fonts.mjs",
    "copy-fonts": "node scripts/copy-font-resources.mjs",
    "predev": "node scripts/ensure-bundled-fonts.mjs",
    "hermes:doctor": "node scripts/hermes-agent-runner.mjs doctor --config automation/hermes-agent/config.example.json",
    "hermes:run": "node scripts/hermes-agent-runner.mjs run --config automation/hermes-agent/config.example.json --task automation/hermes-agent/task.example.json",
    "dev": "electron-vite dev",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:web-next": "cd apps/web-next && next dev --hostname 127.0.0.1 --port 18280",
    "dev:api": "tsx services/api/server.ts",
    "build": "electron-vite build && node scripts/copy-font-resources.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:web-next": "cd apps/web-next && next build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:web-next": "tsc --noEmit -p apps/web-next/tsconfig.json",
    "typecheck:api": "tsc --noEmit -p services/api/tsconfig.json",
    "start:web-next": "cd apps/web-next && next start --hostname 0.0.0.0 --port 18280",
    "preflight:staging": "node scripts/deploy-preflight.mjs staging",
    "preflight:production": "node scripts/deploy-preflight.mjs production",
    "smoke:api": "node scripts/api-smoke.mjs",
    "smoke:auth-send-code": "node scripts/auth-send-code-smoke.mjs",
    "smoke:web-stack": "node scripts/web-stack-smoke.mjs",
    "guard:encoding": "node scripts/encoding-guard.mjs",
    "test:clone-project-workspace": "tsx test/clone-project-workspace.smoke.ts",
    "test:clone-repo-migration": "tsx test/clone-repo-migration.smoke.ts",
    "test:clone-repo-sqlite-source-of-truth": "tsx test/clone-repo-sqlite-source-of-truth.smoke.ts",
    "test:clone-product-binding": "tsx test/clone-product-binding.smoke.ts",
    "test:clone-remote-storyboard-recovery": "tsx test/clone-remote-storyboard-recovery.smoke.ts",
    "test:clone-auto-flow-workflow-progress": "tsx test/clone-auto-flow-workflow-progress.smoke.ts",
    "test:clone-auto-flow-startup-recovery": "tsx test/clone-auto-flow-startup-recovery.smoke.ts",
    "test:clone-auto-flow-resume-runtime": "tsx test/clone-auto-flow-resume-runtime.smoke.ts",
    "test:clone-storyboard-frame-task-pool-runtime": "tsx test/clone-storyboard-frame-task-pool-runtime.smoke.ts",
    "test:clone-video-recovery-with-sqlite-truth": "tsx test/clone-video-recovery-with-sqlite-truth.smoke.ts",
    "test:clone-video-generation-queue-summary": "tsx test/clone-video-generation-queue-summary.smoke.ts",
    "test:clone-video-task-pool-runtime": "tsx test/clone-video-task-pool-runtime.smoke.ts",
    "test:clone-video-submit-idempotency": "tsx test/clone-video-submit-idempotency.smoke.ts",
    "test:clone-video-submission-lock-persistence": "tsx test/clone-video-submission-lock-persistence.smoke.ts",
    "test:clone-shot-video-state-normalization": "tsx test/clone-shot-video-state-normalization.smoke.ts",
    "test:clone-shot-video-downloading-not-done-with-stale-local": "tsx test/clone-shot-video-downloading-not-done-with-stale-local.smoke.ts",
    "test:clone-shot-video-downloading-managed-local-self-heals-to-done": "tsx test/clone-shot-video-downloading-managed-local-self-heals-to-done.smoke.ts",
    "test:clone-shot-video-reconcile-does-not-shortcut-downloading": "tsx test/clone-shot-video-reconcile-does-not-shortcut-downloading.smoke.ts",
    "test:clone-shot-video-done-with-queued-remote-self-heal": "tsx test/clone-shot-video-done-with-queued-remote-self-heal.smoke.ts",
    "test:clone-shot-video-intent-router": "tsx test/clone-shot-video-intent-router.smoke.ts",
    "test:clone-shot-video-done-requires-local-file": "tsx test/clone-shot-video-done-requires-local-file.smoke.ts",
    "test:clone-shot-video-force-regenerate-no-reuse": "tsx test/clone-shot-video-force-regenerate-no-reuse.smoke.ts",
    "test:clone-shot-video-force-regenerate-stale-reset-does-not-restore": "tsx test/clone-shot-video-force-regenerate-stale-reset-does-not-restore.smoke.ts",
    "test:clone-shot-video-force-regenerate-late-old-task-does-not-win": "tsx test/clone-shot-video-force-regenerate-late-old-task-does-not-win.smoke.ts",
    "test:clone-shot-video-batch-retry-old-task-does-not-restore": "tsx test/clone-shot-video-batch-retry-old-task-does-not-restore.smoke.ts",
    "test:clone-shot-video-batch-submit-manual-sync-late-old-task-guard": "tsx test/clone-shot-video-batch-submit-manual-sync-late-old-task-guard.smoke.ts",
    "test:clone-shot-video-force-regenerate-bypass-submission-lock": "tsx test/clone-shot-video-force-regenerate-bypass-submission-lock.smoke.ts",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "test:web-next-clone-flow": "node test/web-next-clone-flow.e2e.cjs",
    "test:storyboard-model-lock": "tsx test/storyboard-model-identity-lock.smoke.ts",
    "test:product-library-desktop": "node test/product-library-desktop.smoke.cjs",
    "test:clone-shot-video-get-project-pure-read": "tsx test/clone-shot-video-get-project-pure-read.smoke.ts",
    "test:clone-shot-video-late-regression-guard": "tsx test/clone-shot-video-late-regression-guard.smoke.ts",
